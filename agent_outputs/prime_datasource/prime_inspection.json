            {"name": "BioProject", "type": "string", "sample": "PRJDB13875", "classification": "IDENTIFIER"},
            {"name": "BioSample", "type": "string", "sample": "SAMD00518187", "classification": "IDENTIFIER"},
            {"name": "Experiment", "type": "string", "sample": "DRX382752", "classification": "IDENTIFIER"},
            {"name": "SRA_Study", "type": "string", "sample": "DRP010964", "classification": "IDENTIFIER"},
            {"name": "Project_name", "type": "string", "sample": "MUSC-JP-2024", "classification": "NOVEL"},
            {"name": "Systems", "type": "string", "sample": "Digestive System/Gut", "classification": "NOVEL", "note": "10-system body system hierarchy (PRIME internal)"},
            {"name": "Body_Site", "type": "string", "sample": "Stool/feces", "classification": "NOVEL", "note": "94 specific body sites (PRIME internal controlled vocabulary, maps to bodySiteId)"},
