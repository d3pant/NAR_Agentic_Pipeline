            {"name": "Host_Height", "type": "float", "sample": null, "classification": "NOVEL"},
            {"name": "Host_Weight", "type": "float", "sample": null, "classification": "NOVEL"},
            {"name": "Host_BMI", "type": "float", "sample": null, "classification": "NOVEL"},
            {"name": "Race_or_Ethnicity", "type": "string", "sample": null, "classification": "NOVEL", "note": "Confirmed present in schema; sparsely populated"},
            {"name": "Host_Menopausal_Status", "type": "string", "sample": null, "classification": "NOVEL"},
            {"name": "Host_Birth_Year", "type": "integer", "sample": null, "classification": "NOVEL"},
            {"name": "Host_Country_Birth", "type": "string", "sample": null, "classification": "NOVEL"},
            {"name": "Country", "type": "string", "sample": "Japan", "classification": "NOVEL"},
            {"name": "Continent", "type": "string", "sample": "Asia", "classification": "NOVEL"},
            {"name": "Smoke_Status", "type": "string", "sample": null, "classification": "NOVEL"},
            {"name": "Drinking_Status", "type": "string", "sample": null, "classification": "NOVEL"},
            {"name": "Diet_Type", "type": "string", "sample": null, "classification": "NOVEL"},
            {"name": "Antibiotics_Use", "type": "string", "sample": null, "classification": "NOVEL"},
            {"name": "Collection_Date", "type": "date", "sample": "2020-08-05", "classification": "NOVEL"},
            {"name": "Instrument", "type": "string", "sample": "Illumina MiSeq", "classification": "NOVEL"},
            {"name": "Library_Layout", "type": "string", "sample": "Paired", "classification": "NOVEL"},
            {"name": "Variable_Region", "type": "string", "sample": "V1-V2", "classification": "NOVEL"},
            {"name": "Sequencing_Quality", "type": "string", "sample": "Good", "classification": "NOVEL", "note": "5-level QC scoring: Excellent/Good/Fair/Poor/Very Poor"},
            {"name": "Filter_Pass", "type": "string", "sample": "Excellent", "classification": "NOVEL", "note": "DADA2 processing retention rate score"},
            {"name": "Time_series", "type": "string", "sample": "no", "classification": "NOVEL"},
            {"name": "Comparison", "type": "string", "sample": "yes", "classification": "NOVEL"},
            {"name": "Matched", "type": "string", "sample": "no", "classification": "NOVEL"},
            {"name": "Collapse", "type": "string", "sample": "Silva and greengenes2", "classification": "NOVEL"},
            {"name": "Tumor_Stage", "type": "string", "sample": null, "classification": "NOVEL"},
            {"name": "Doi", "type": "string", "sample": null, "classification": "IDENTIFIER"}
        ],
        "primary_key": {
            "field": "Run",
            "type": "SRA run accession",
            "sample": "DRR396973",
            "note": "Globally unique SRA run accession (DRR/ERR/SRR prefix). Used as document _id in pending.api."
        },
        "identifiers": [
            {"type": "SRA run accession", "field": "Run", "sample": "DRR396973"},
            {"type": "BioProject accession", "field": "BioProject", "sample": "PRJDB13875"},
            {"type": "BioSample accession", "field": "BioSample", "sample": "SAMD00518187"},
            {"type": "SRA Experiment", "field": "Experiment", "sample": "DRX382752"},
            {"type": "NCBI Taxonomy ID", "field": "(taxon column headers in abundance CSVs)", "sample": "taxon string mapped to NCBI taxon ID per paper"}
        ],
        "abundance_matrix_structure": {
            "note": "Zenodo abundance CSVs are wide-format matrices: rows = SRA run accessions, columns = taxon names. Taxon names are SILVA or GG2 labels; paper states NCBI taxon ID mapping was attempted per taxon.",
            "join_key": "Run (row index of abundance CSV = Run column in samples_metadata.csv)"
        }
    },
    "license": {
        "stated_paper": "CC BY 4.0 + MIT",
        "observed_site": "CC BY 4.0 + MIT (Zenodo deposit)",
        "match": true,
        "restrictions": ["Attribution required under CC-BY 4.0"]
    },
    "plugin_inputs": {
        "data_url": [
            "https://zenodo.org/records/15711237/files/samples_metadata.csv",
            "https://zenodo.org/records/15711237/files/silva_species_absolute.csv",
            "https://zenodo.org/records/15711237/files/silva_species_relative.csv",
            "https://zenodo.org/records/15711237/files/silva_genus_absolute.csv",
            "https://zenodo.org/records/15711237/files/silva_genus_relative.csv",
            "https://zenodo.org/records/15711237/files/projects_metadata.csv"
        ],
        "primary_key_field": "Run",
        "target_api": "pending.api",
        "ingestion_path": "bulk_download",
        "ingestion_notes": "Download samples_metadata.csv as the spine document. For each sample (Run), join abundance data from silva_species_absolute.csv and silva_species_relative.csv by Run (row index). Emit one document per sample with metadata fields + nested taxonomy.silva.species.absolute and taxonomy.silva.species.relative sub-documents. Genus-level abundance is optional secondary resolution to include. GG2 files are supplementary — include if storage permits, otherwise prioritize SILVA as the more widely cited reference.",
        "novel_fields": [
            "Systems", "Body_Site", "Phenotype", "Study_Group", "Host_Age", "Host_Sex",
            "Host_BMI", "Host_Height", "Host_Weight", "Race_or_Ethnicity", "Host_Menopausal_Status",
            "Smoke_Status", "Drinking_Status", "Diet_Type", "Antibiotics_Use", "Country", "Continent",
            "Sequencing_Quality", "Filter_Pass", "Variable_Region", "Time_series", "Comparison", "Matched",
            "silva_species_absolute", "silva_species_relative", "silva_genus_absolute", "silva_genus_relative"
        ],
        "redundant_fields": []
    },
    "api_crawl_details": {
        "base_url": "https://primedb.sjtu.edu.cn/api/v1",
        "endpoints": [
            "/samples/list — returns array of all SRA run accessions",
            "/samples/:run/stats — returns full metadata for one sample (80+ fields)",
            "/phenotypes/list — 102 phenotype entries (phenotypeId, phenotypeName)",
            "/bodysites/list — 94 body site entries (bodySiteId, bodySiteName, system)",
            "/stats — database-level counts (totalProjects, totalSamples, etc.)"
        ],
        "pagination": "limit parameter supported; /samples/list returns all 53,449 run accessions in one call",
        "total_records": 53449,
        "rate_limits": "none documented; caution advised against simultaneous requests",
        "auth": "none",
        "response_shape": "{success: true, data: [...], count: N, message: '...'}",
        "note": "API is viable for metadata-only access but NOT recommended for abundance data — abundance must come from Zenodo bulk CSVs. Bulk download strategy is preferred.",
        "sample_curl": "curl -s 'https://primedb.sjtu.edu.cn/api/v1/samples/DRR396973/stats' | python3 -m json.tool"
    },
    "paper_vs_reality": [
        {"claim": "53,449 samples", "observed": "53,449 (API /stats confirmed)", "match": true},
        {"claim": "111 studies", "observed": "111 (API /stats confirmed)", "match": true},
        {"claim": "93 body sites", "observed": "94 (bodysites/list returns 94 including 'Non-human' and 'Unknown')", "match": false, "note": "MISMATCH — paper counts 93 human body sites; API returns 94 including non-human/unknown entries"},
        {"claim": "101 phenotypic categories", "observed": "102 (phenotypes/list returns 102 including 'Gestatiol diabetes' and 'Microcolitis')", "match": false, "note": "MISMATCH — minor: paper count 101, API has 102; likely new phenotypes added after paper cutoff"},
        {"claim": "Freely accessible without login", "observed": "Confirmed — Zenodo files public, API requires no auth", "match": true},
        {"claim": "CC-BY 4.0 + MIT license", "observed": "Confirmed on Zenodo deposit page", "match": true},
        {"claim": "NCBI taxon ID mapping attempted for all taxa", "observed": "Stated in paper; cannot verify without downloading abundance CSV headers", "match": null}
    ],
    "risks": [
        "Abundance CSV files are very large (up to 1.8 GB each, 9.1 GB total) — parser must stream/chunk, not load into memory",
        "Wide-format abundance matrix (samples x taxa) requires transpose/melt to per-sample nested structure — O(samples x taxa) memory during join",
        "Race_or_Ethnicity and demographic fields (Host_Age, Host_Sex, Host_BMI) are sparsely populated — many nulls expected in output documents",
        "Phenotype and body site controlled vocabulary is PRIME-internal (no MONDO/HPO/UBERON mapping) — downstream KG integration requires entity resolution",
        "Minor count discrepancies between paper and live API (93→94 body sites, 101→102 phenotypes) — use API counts as ground truth",
        "NCBI taxon ID mapping of abundance CSV column headers unverified — requires column header inspection after download",
        "Zenodo is the canonical download (not PRIME homepage, which is JS-rendered) — URLs in manifest should point to zenodo.org"
    ]
}
